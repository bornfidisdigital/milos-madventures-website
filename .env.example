# Email inquiries via Web3Forms — leave blank until we have a key.
# ONE-LINE SWAP: paste the access key after the equals sign. No other code change.
# Local file: copy this to .env.local
# Vercel: Project → Settings → Environment Variables → WEB3FORMS_ACCESS_KEY
# WhatsApp on /plan works without this.
WEB3FORMS_ACCESS_KEY=

# Set this on Vercel to the preview URL Vercel gives you (https://....vercel.app).
# Do not set this to a custom domain until that domain is actually connected.
NEXT_PUBLIC_SITE_URL=
